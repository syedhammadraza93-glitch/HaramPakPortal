# ---- Database (Neon / Supabase PostgreSQL) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DB_POOL_MAX=10
# Connections kept open and pinged every 30s (set 0 for a local database)
DB_WARM_CONNECTIONS=4

# ---- App ----
PORT=5002
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- Auth ----
# Long random string (min 32 chars): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---- First Super Admin (created once, only while the users table is empty) ----
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="System Administrator"

# ---- Email (leave SMTP_HOST empty to print emails in the server console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Haram Pak (Pvt) Ltd <no-reply@example.com>"

# ---- File storage (local disk for now; S3-compatible later) ----
STORAGE_DIR=./storage

# ---- CAPTCHA on agent sign-up (Cloudflare Turnstile, free: https://dash.cloudflare.com/?to=/:account/turnstile) ----
# The keys below are Cloudflare's official TEST keys (always pass). Replace with real keys before going live.
# Leave both empty to switch CAPTCHA off.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Allow browser lead capture from this exact customer website origin.
# PUBLIC_WEBSITE_URL=https://www.harampak.pk

# Stable server-only 32-byte hex key used to encrypt integration credentials at rest.
# INTEGRATION_ENCRYPTION_KEY=
